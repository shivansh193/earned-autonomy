# App image for Cloud Run: the FastAPI backend serving the built React frontend from the
# same origin, so every deploy, prod monitor and rollback covers the UI too.
# Build context: repo root.
FROM oven/bun:1.3 AS frontend-build
WORKDIR /app
COPY package.json bun.lock ./
COPY frontend/package.json frontend/
RUN bun install --frozen-lockfile
COPY frontend frontend
# Same origin as the API: no VITE_API_URL. vite writes to ../backend/app/frontend.
RUN mkdir -p backend/app && cd frontend && bun run build

FROM python:3.14-slim

ENV PYTHONUNBUFFERED=1 UV_COMPILE_BYTECODE=1 UV_LINK_MODE=copy PATH="/app/.venv/bin:$PATH"
COPY --from=ghcr.io/astral-sh/uv:0.9.26 /uv /uvx /bin/

WORKDIR /app
COPY pyproject.toml uv.lock ./
COPY backend/pyproject.toml backend/alembic.ini backend/
RUN uv sync --frozen --no-dev --package app --no-install-workspace

COPY backend/app backend/app
COPY backend/scripts backend/scripts
COPY tools tools
RUN uv sync --frozen --no-dev --package app \
 && uv pip install --no-deps -e tools
COPY --from=frontend-build /app/backend/app/frontend backend/app/frontend

WORKDIR /app/backend
# Migrate, ensure the first superuser, then serve. Cloud Run sets PORT.
CMD ["sh", "-c", "alembic upgrade head && python app/initial_data.py && exec fastapi run app/main.py --host 0.0.0.0 --port ${PORT:-8080} --workers 1"]
